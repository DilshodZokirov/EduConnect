# Ma'lumotlar bazasi
DATABASE_URL=postgresql+asyncpg://edu:edu@db:5432/educonnect

# Telegram bot tokeni (@BotFather dan)
BOT_TOKEN=123456:ABC-DEF...

# Web App manzili (ngrok yoki domen) — oxirida /app bo'lsin
WEBAPP_URL=https://xxxx.ngrok-free.app/app

# JWT uchun maxfiy kalit — uzun tasodifiy satr qo'ying
JWT_SECRET=change-me-to-a-long-random-string

# Superadminlarning Telegram ID lari (JSON ro'yxat)
SUPERADMIN_TELEGRAM_IDS=[111111111]

# SMS: "console" (test uchun, SMS terminalga chiqadi) yoki "eskiz"
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Web App manzili (CORS uchun)
CORS_ORIGINS=["https://your-webapp-domain.uz"]

# Fayl ombori. Sinovda docker-compose'dagi MinIO ishlatiladi — quyidagilarni o'zgartirmang.
# Real ishda (masalan Cloudflare R2): S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com,
# S3_REGION=auto, kalitlarni R2 kabinetidan oling va S3_PUBLIC_BASE ni bo'sh qoldiring.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=educonnect
S3_SECRET_KEY=educonnect-secret
S3_BUCKET=educonnect
S3_REGION=us-east-1
S3_PUBLIC_BASE=/storage
MAX_FILE_MB=100
MAX_VIDEO_MB=2048
